{
  "name": "unfair-weekend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "supabase",
    "db:check": "pnpm --filter @repo/db-tools db:check",
    "db:test": "pnpm --filter @repo/db-tools db:test",
    "db:types": "pnpm --filter @repo/db-tools db:types",
    "db:test:race": "pnpm --filter @repo/db-tools db:test:race",
    "db:seed": "pnpm --filter @repo/db-tools db:seed",
    "db:push-secrets": "pnpm --filter @repo/db-tools db:push-secrets",
    "pay:e2e": "pnpm --filter @repo/db-tools pay:e2e"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "supabase": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}

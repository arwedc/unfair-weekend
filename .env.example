# ─────────────────────────────────────────────────────────────────────────────
# Root-.env für Tools und Skripte (Migrationen, Tests, Seed, Typgenerierung).
# Kopieren nach `.env` und ausfüllen. `.env` wird NIE committet.
#
# Alle Werte stammen aus dem Supabase-Dashboard des Dev-Projekts.
# Für den späteren Live-Betrieb werden nur diese Werte ausgetauscht.
#
# apps/web und apps/mobile haben eigene .env-Dateien (siehe unten).
# ─────────────────────────────────────────────────────────────────────────────

# Projekt-Referenz (Dashboard → Project Settings → General → Project ID)
SUPABASE_PROJECT_REF=

# API-URL (Dashboard → Project Settings → Data API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable Key (sb_publishable_…): unkritisch, darf in Apps.
# Dashboard → Project Settings → API Keys
SUPABASE_PUBLISHABLE_KEY=

# Secret Key (sb_secret_…): umgeht RLS. NUR für lokale Skripte und Server-Code,
# niemals in apps/mobile oder in NEXT_PUBLIC_-Variablen.
SUPABASE_SECRET_KEY=

# Datenbank-Passwort (beim Anlegen des Projekts vergeben, im Dashboard zurücksetzbar).
# Die Supabase CLI liest es für `supabase link` und `supabase db push`.
SUPABASE_DB_PASSWORD=

# Postgres-Verbindung für Tests, Migrations-Probelauf und Seed: Session-Pooler (Port 5432, IPv4).
# Dashboard → oben „Connect“ → „Session pooler“. Nicht den Transaction-Pooler (6543) nehmen.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-passwort>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional: Personal Access Token (supabase.com/dashboard/account/tokens).
# Nur nötig, falls die Typgenerierung über die Management API laufen muss.
SUPABASE_ACCESS_TOKEN=

# Passwort aller Testkonten aus dem Seed. Das Repo ist öffentlich,
# deshalb steht es nur hier und wird im Team direkt weitergegeben.
SEED_TEST_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Zur Info, gehören NICHT in diese Datei:
#
# apps/web/.env.local
#   NEXT_PUBLIC_SUPABASE_URL=
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
#   SUPABASE_SECRET_KEY=          (nur falls serverseitig nötig, nie NEXT_PUBLIC_)
#
# apps/mobile/.env
#   EXPO_PUBLIC_SUPABASE_URL=
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ─────────────────────────────────────────────────────────────────────────────

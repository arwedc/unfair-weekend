# Vorlage für apps/mobile/.env (die echte .env wird nie committet).
# In die App kommen NUR die Projekt-URL und der Publishable Key.
# Der Secret Key (sb_secret_…) gehört niemals hierher.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Stripe (Zahlungen, Variante B): NUR der Publishable Key aus der Sandbox (pk_test_…).
# Der Secret Key gehört nie in die App. Leer lassen = Bezahlen ist in der App aus.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Kartenstil (OpenFreeMap, kein Key nötig). Leer lassen = Standard „Positron“.
EXPO_PUBLIC_MAP_STYLE_URL=

# Login-Methoden: erst auf 1 setzen, wenn sie in Supabase eingerichtet sind.
# In Entwicklungs-Builds (auch Expo Go) gibt es zusätzlich immer den Test-Login für die Seed-Konten.
EXPO_PUBLIC_AUTH_EMAIL_OTP=0
EXPO_PUBLIC_AUTH_APPLE=0
EXPO_PUBLIC_AUTH_GOOGLE=0

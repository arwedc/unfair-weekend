# Vorlage für apps/mobile/.env (die echte .env wird nie committet).
# In die App kommen NUR die Projekt-URL und der Publishable Key.
# Der Secret Key (sb_secret_…) gehört niemals hierher.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Kartenstil (OpenFreeMap, kein Key nötig). Leer lassen = Standard „Positron“.
EXPO_PUBLIC_MAP_STYLE_URL=
